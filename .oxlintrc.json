{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import"],
  "settings": {
    "react": {
      "version": "19.2.0"
    },
    "jsx-a11y": {
      "components": {
        "Link": "a"
      }
    }
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "src/routeTree.gen.ts", "mockups/**"]
}
